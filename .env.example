# ---------------------------------------------------------------------------
# OpenLoft frontend — environment template
#
# Copy to `.env.local` and fill in. That file is gitignored; this one is not.
#
#   cp .env.example .env.local
#
# !! EVERY NEXT_PUBLIC_* VARIABLE IS PUBLIC !!
# Next.js inlines these into the client bundle at build time. Anything in a
# NEXT_PUBLIC_ variable is readable by anyone who loads the page. Never put a
# server secret, API key, or token in one.
# ---------------------------------------------------------------------------


# Base URL of the backend API.
#
# Include the /api suffix. lib/api.ts uses this verbatim as the Axios
# baseURL, so it must end at /api.
#
# The bug this prevents: hand-rolled `fetch` calls in
# app/dashboard/team/** and app/enterprise/onboarding/page.tsx treated this
# variable as a bare host and appended "/api/..." themselves, producing
# /api/api/teams and a 404 on every team and enterprise request.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Google OAuth client ID for the sign-in button. Public by design; the
# matching secret lives in backend/.env as GOOGLE_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Used only to gate a dev-only banner in app/dashboard/billing/page.tsx.
# Prefer process.env.NODE_ENV, which is built in.
NEXT_PUBLIC_NODE_ENV=dev


# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# The open-source NMAFC framework is ready. The two hosted products built on
# top of it are still under construction.
#
# While both are off, the account area is gated: /auth/login, /auth/register,
# /onboarding, every /dashboard/* route, /enterprise and /enterprise/onboarding
# render a pre-launch notice instead, and the sign-in / get-started CTAs are
# removed from the marketing pages. The marketing and docs surfaces stay fully
# available, because the framework is the product right now.
#
# The account area opens as soon as EITHER flag is true.
#
# Values are inlined at build time, so flipping either flag requires a
# rebuild. Next.js does this by plain text substitution of
# `process.env.NEXT_PUBLIC_*` — a variable lookup such as
# `process.env[name]` is not statically analysable and never gets inlined,
# so the browser bundle would fall back to `false` no matter what you set
# here while the server resolved it differently. That mismatch is a hydration
# error, so lib/features.ts reads each flag through a literal member
# expression on purpose.
#
# Accepts true/false, 1/0, yes/no, on/off. An unrecognised value falls back to
# false and logs a warning, so a typo cannot accidentally open sign-up.
NEXT_PUBLIC_FEATURE_HOSTED_HARNESS=false
NEXT_PUBLIC_FEATURE_HOSTED_MEMORY=false
